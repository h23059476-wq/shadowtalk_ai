rules_version = '2';

// ShadowTalk AI — Cloud Storage Security Rules
// Deploy with: firebase deploy --only storage
// Paths are written by the adapter as: <bucket-name>/<path>
service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    // Public, read-only assets (logos, share images).
    match /public-assets/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    // Marketing/email assets — read-only for everyone, no client writes.
    match /email-assets/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    // Everything else is private, namespaced per user: <bucket>/<uid>/<file>
    // NOTE: Storage rules grant via UNION across matching blocks. This
    // catch-all also matches public-assets/<uid>/… and email-assets/<uid>/…,
    // so without the explicit exclusion below it silently re-granted writes
    // into the two read-only trees above.
    match /{logicalBucket}/{uid}/{allPaths=**} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow delete: if signedIn() && request.auth.uid == uid
        && logicalBucket != 'public-assets'
        && logicalBucket != 'email-assets';
      allow write: if signedIn() && request.auth.uid == uid
        && logicalBucket != 'public-assets'
        && logicalBucket != 'email-assets'
        && request.resource.size < 25 * 1024 * 1024;
    }

  }
}
