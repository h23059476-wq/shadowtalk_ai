# Required — Gemini API key (free tier available at aistudio.google.com)
# Used by the n8n "Gemini Content Engine" HTTP node (header x-goog-api-key).
# Access it in n8n expressions as {{ $env.GEMINI_API_KEY }} — set this in the
# n8n process environment (docker-compose environment / .env next to n8n).
GEMINI_API_KEY=

# Required — URL of your self-hosted Postiz webhook (or Buffer/Zapier-compatible
# endpoint). The "Postiz Social Post" HTTP node POSTs the LinkedIn copy, the
# X thread and the blog link to this URL.
POSTIZ_WEBHOOK_URL=

# Not read via env: the GitHub credential (GITHUB_TOKEN) is stored as an n8n
# credential ("GitHub API", token type) and selected on the "Commit Blog Post"
# node after import. Scope needed: Contents — Read & Write on shadowtalk_ai.
GITHUB_TOKEN=
